# Local mode preserves all migrated content until a Sanity project is connected.
CONTENT_SOURCE=local
PUBLIC_INDEXABLE=false
# Before publishing: https://USERNAME.github.io and /REPOSITORY/ for Pages.
SITE_URL=http://127.0.0.1:4321
BASE_PATH=/
# Fill these only when the real Sanity project exists.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-11-01
# Server/build only, optional read token for private datasets. Never PUBLIC_.
SANITY_READ_TOKEN=
# Server-only credential for the one-off import; never commit this value.
SANITY_WRITE_TOKEN=
PUBLIC_STUDIO_URL=
# Only for the private editor preview server. Never add this token to Studio or the static build.
SANITY_PREVIEW_TOKEN=
SANITY_PREVIEW_STUDIO_ORIGINS=
