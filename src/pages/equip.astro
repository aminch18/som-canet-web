---
import Layout from '../layouts/Layout.astro';import {getContent,pageBy,mediaUrl} from '../lib/content';import {withBase} from '../lib/urls';import {renderBody} from '../lib/render';
const docs=await getContent();const page=pageBy(docs,'equip')!;const people=docs.filter(d=>d._type==='person').sort((a,b)=>(a.order||0)-(b.order||0));
---
<Layout title={page.title!} doc={page} section="projecte"><section class="page-heading wrap"><p class="eyebrow">PERSONES DEL PROJECTE</p><h1>{page.title}</h1><p class="lead">{page.summary}</p></section><div class="wrap section">{page.historical&&<p class="historical-note">Composició i biografies recollides a la web d’origen. Les edats i els càrrecs corresponen a aquell moment.</p>}{page.cover&&<img class="team-photo" src={withBase(mediaUrl(page.cover))} alt={page.cover.alt||'Equip històric de SOM CANET'}/>}<div class="people-grid">{people.map(person=><article class="person">{person.portrait&&<img src={withBase(mediaUrl(person.portrait))} alt={person.portrait.alt||person.name} loading="lazy" width="120" height="160"/>}<div><p class="role">{person.role}</p><h2>{person.name}</h2><div set:html={renderBody(person.bio,docs)}/></div></article>)}</div></div></Layout>
