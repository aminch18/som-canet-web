---
import EditorialBlocks from '../components/EditorialBlocks.astro';
import {editorField} from '../lib/editor-field';
import Layout from '../layouts/Layout.astro';import Card from '../components/Card.astro';import {requestContent,settingsOf,posts,mediaUrl} from '../lib/content';import {withBase} from '../lib/urls';
const docs=await requestContent(Astro.locals);const settings=settingsOf(docs);const current=posts(docs).filter(d=>!d.historical);const feed=current.length?current:posts(docs).slice(0,3);
---
<Layout title="SOM CANET" description={settings.seo?.description}>
<section class="home-hero"><img data-sanity={editorField(Astro.locals,settings,'homeImage')} src={withBase(mediaUrl(settings.homeImage))} width="1800" height="1350" alt={settings.homeImage?.alt||'Canet de Mar'} fetchpriority="high"/><div class="wrap hero-inner"><div class="hero-panel"><p class="eyebrow">SOM CANET</p><h1 data-sanity={editorField(Astro.locals,settings,'homeTitle')}>{settings.homeTitle}</h1><p data-sanity={editorField(Astro.locals,settings,'homeIntro')}>{settings.homeIntro}</p><a class="button green" href={withBase('/projecte/')}>Coneix el projecte <span aria-hidden="true">→</span></a></div><span class="photo-caption">CANET DE MAR · EL NOSTRE PUNT DE PARTIDA</span></div></section>
<section class="home-directory wrap"><div class="section-header"><div><p class="eyebrow">CONEIX SOM CANET</p><h2 data-sanity={editorField(Astro.locals,settings,'homeDirectoryTitle')}>{settings.homeDirectoryTitle || 'Un projecte que es construeix sumant.'}</h2></div><p data-sanity={editorField(Astro.locals,settings,'homeDirectoryIntro')}>{settings.homeDirectoryIntro || 'Idees, persones i compromís amb el municipi.'}</p></div><div class="directory-grid"><a href={withBase('/historia/')}><span class="directory-icon" aria-hidden="true">◎</span><h3>Les nostres arrels</h3><p>El projecte, l’acord fundacional i les persones que hi van donar forma.</p><span class="link-label">La nostra història →</span></a><a href={withBase('/grup-municipal/')}><span class="directory-icon" aria-hidden="true">▤</span><h3>La vida municipal</h3><p>Documents, discursos i balanç de la trajectòria institucional.</p><span class="link-label">Grup municipal →</span></a><a href={withBase('/revista/')}><span class="directory-icon" aria-hidden="true">↔</span><h3>Veus pròpies</h3><p>La revista original i els articles de les persones del projecte.</p><span class="link-label">Llegeix la revista →</span></a></div></section>
<section class="home-feed wrap"><div class="section-header"><div><p class="eyebrow">{current.length?'ACTUALITAT':'DE LA NOSTRA HEMEROTECA'}</p><h2>{current.length?'Les veus i les idees de SOM CANET.':'Les idees queden. La memòria, també.'}</h2></div><a class="text-link" href={withBase('/arxiu/')}>Explora tot l’arxiu →</a></div><div class="archive-grid">{feed.slice(0,3).map(doc=><Card doc={doc}/>)}</div></section>
<section class="home-participate"><div class="wrap"><div><p class="eyebrow">LA TEVA VEU HI TÉ LLOC</p><h2 data-sanity={editorField(Astro.locals,settings,'homeParticipationTitle')}>{settings.homeParticipationTitle || <>Una idea per a Canet?<br/>Comencem parlant.</>}</h2><p data-sanity={editorField(Astro.locals,settings,'homeParticipationIntro')}>{settings.homeParticipationIntro || 'Comparteix una proposta, fes una pregunta o demana informació per participar.'}</p></div><a class="button" href={withBase('/participa/')}>Troba la teva manera de participar →</a></div></section>
<EditorialBlocks doc={settings} docs={docs} fullWidth/>
</Layout>
