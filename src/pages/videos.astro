---
import EditorialBlocks from '../components/EditorialBlocks.astro';
import {editorField} from '../lib/editor-field';
import Layout from '../layouts/Layout.astro';import {requestContent,pageBy} from '../lib/content';const docs=await requestContent(Astro.locals);const page=pageBy(docs,'videos')!;const videos=docs.filter(d=>d._type==='video').sort((a,b)=>(a.order||0)-(b.order||0));
---
<Layout title="Vídeos" doc={page} section="revista"><section class="page-heading wrap"><p class="eyebrow">VEUS I IMATGES</p><h1 data-sanity={editorField(Astro.locals,page,'title')}>{page.title}</h1>{page.summary && <p class="lead" data-sanity={editorField(Astro.locals,page,'summary')}>{page.summary}</p>}</section><div class="wrap article-layout"><div><p class="historical-note">Vídeos de l’arxiu original de SOM CANET.</p>{videos.map(video=><section class="video-item"><h2 data-sanity={editorField(Astro.locals,video,'title')}>{video.title}</h2><iframe src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}`} title={video.title} loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen/><a href={`https://www.youtube.com/watch?v=${video.youtubeId}`} target="_blank" rel="noopener noreferrer">Obre el vídeo a YouTube ↗</a></section>)}<h2>El Bon Govern</h2><p class="muted">Aquest títol apareix a la pàgina original, però no hi ha cap vídeo associat recuperable.</p></div></div><EditorialBlocks doc={page} docs={docs} fullWidth/>
</Layout>
