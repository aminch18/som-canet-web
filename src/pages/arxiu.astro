---
import Layout from '../layouts/Layout.astro';import Card from '../components/Card.astro';import {getContent,posts} from '../lib/content';
const docs=await getContent();const resources=[...posts(docs),...docs.filter(d=>d._type==='publication'||(d._type==='page'&&d.historical))];
const filters=[['all','Tot'],['actualitat','Actualitat'],['hemeroteca','Hemeroteca'],['revista','Revista'],['documents','Documents'],['grup-municipal','Vida municipal'],['projecte','El projecte']];
---
<Layout title="Arxiu" description="Explora articles, revistes i documents de SOM CANET amb cerca i filtres." section="arxiu"><section class="page-heading wrap"><p class="eyebrow">ARXIU OBERT</p><h1>Tot el que hem compartit.</h1><p class="lead">Articles, publicacions, documents i imatges de SOM CANET. Troba els continguts pel seu títol o explora’ls per seccions.</p></section><section class="wrap section"><div class="archive-controls"><label for="archive-search">Cerca per títol</label><input type="search" id="archive-search" placeholder="Pressupostos, igualtat, revista…"/><div class="filters" role="group" aria-label="Tipus de contingut">{filters.map(([value,label])=><button type="button" data-filter={value} aria-pressed={value==='all'?'true':'false'}>{label}</button>)}</div><p id="archive-count" role="status">{resources.length} recursos</p></div><div class="archive-grid">{resources.map(doc=><Card doc={doc} category={doc._type==='publication'?'documents':undefined}/>)}</div><p id="archive-empty" hidden>No hem trobat cap resultat. Canvia la cerca o selecciona un altre tipus de contingut.</p></section></Layout>
