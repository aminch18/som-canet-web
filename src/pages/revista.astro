---
import Layout from '../layouts/Layout.astro';import Card from '../components/Card.astro';import PdfReader from '../components/PdfReader.astro';import {getContent,pageBy,routeFor,type ContentDoc} from '../lib/content';import {withBase} from '../lib/urls';
const docs=await getContent();const page=pageBy(docs,'revista')!;const publications=(page.documents||[]).map(r=>docs.find(d=>d._id===r._ref)).filter(Boolean) as ContentDoc[];const authors=docs.filter(d=>d._type==='page'&&d.section==='revista'&&!['revista','videos'].includes(d.slug!.current));
---
<Layout title={page.title!} doc={page} section="revista"><section class="page-heading wrap"><p class="eyebrow">PUBLICACIONS</p><h1>{page.title}</h1><p class="lead">{page.summary}</p></section><nav class="wrap subnav" aria-label="Articles de la revista">{authors.map(d=><a href={withBase(routeFor(d))}>{d.title}</a>)}<a href={withBase('/videos/')}>Vídeos</a></nav><section class="wrap section"><p class="historical-note">Publicacions històriques de SOM CANET. Els articles conserven el context de la seva època.</p>{publications.map(doc=><section class="related-document"><h2>{doc.title}</h2><a class="text-link" href={withBase(routeFor(doc))}>Lectura i text complet →</a><PdfReader doc={doc}/></section>)}<div class="section-header"><h2>Veus de la revista</h2></div><div class="archive-grid">{authors.map(doc=><Card doc={doc}/>)}</div></section></Layout>
