---
import Layout from '../layouts/Layout.astro';import {getContent,pageBy} from '../lib/content';import {withBase} from '../lib/urls';const docs=await getContent();const doc=pageBy(docs,'participa')!;
const intents=[['proposta','Tinc una proposta','Explica’ns què tens al cap.'],['participar','Vull donar un cop de mà','Comença posant-te en contacte.'],['consulta','Vull saber-ne més','Pregunta’ns. T’escoltem.']];
---
<Layout title="Participa" section="participa" doc={doc}><section class="page-heading wrap"><p class="eyebrow">PARTICIPA</p><h1>{doc.title}</h1><p class="lead">{doc.summary}</p></section><section class="participate-section"><div class="wrap participate-grid"><div><p class="eyebrow">TRIA PER ON COMENÇAR</p><h2>La teva veu hi té lloc.</h2><p>Una idea per al teu carrer? Una pregunta sobre el projecte? Ganes de participar? Comencem parlant.</p><a class="button light" href={withBase('/contacte/')}>Parlem-ne →</a></div><div class="participate-options">{intents.map(([value,title,text],i)=><a href={withBase(`/contacte/?motiu=${value}#contact-form`)}><span>{i+1}</span><div><h3>{title}</h3><p>{text}</p></div><span aria-hidden="true">↗</span></a>)}</div></div></section><section class="wrap faq"><h2>Abans de començar</h2>{doc.faqs?.map(faq=><details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</section></Layout>
