---
import EditorialBlocks from '../components/EditorialBlocks.astro';
import {editorField} from '../lib/editor-field';
import Layout from '../layouts/Layout.astro';import {requestContent,settingsOf,pageBy} from '../lib/content';const docs=await requestContent(Astro.locals);const site=settingsOf(docs);const doc=pageBy(docs,'contacte')!;
---
<Layout title="Contacte" section="contacte" doc={doc}><section class="page-heading wrap"><p class="eyebrow">CONTACTE</p><h1 data-sanity={editorField(Astro.locals,doc,'title')}>{doc.title}</h1><p class="lead" data-sanity={editorField(Astro.locals,doc,'summary')}>{doc.summary}</p></section><section class="section wrap contact-grid"><div><p class="eyebrow">CONTACTE DIRECTE</p><h2>Parlem-ne.</h2><p>Tria la manera que et sigui més còmoda.</p><a class="contact-email" href={`mailto:${site.contactEmail}`}>{site.contactEmail} ↗</a><a class="contact-phone" href={`tel:+34${site.contactPhone?.replace(/\s/g,'')}`}>{site.contactPhone}<span>Truca’ns ↗</span></a></div><form id="contact-form" data-email={site.contactEmail}><h3>Què ens vols explicar?</h3><p class="form-intro">Prepara el missatge i obre’l al teu correu.</p><label for="name">Com et dius?</label><input id="name" name="name" autocomplete="name" placeholder="El teu nom" required maxlength="100"/><label for="intent">De què vols parlar?</label><select id="intent" name="intent"><option value="proposta">Tinc una proposta per a Canet</option><option value="participar">M’agradaria participar</option><option value="consulta">Tinc una consulta</option></select><label for="message">El teu missatge</label><textarea id="message" name="message" rows="4" placeholder="T’escoltem…" required maxlength="3000"/><button class="button" type="submit">Preparar el correu ↗</button><p class="form-note">S’obrirà la teva aplicació de correu. Revisa el missatge abans d’enviar-lo. Aquest web no desa les teves dades.</p><p id="form-status" role="status" hidden/><div id="mail-fallback" hidden><button type="button" class="text-link" id="copy-message">Copiar missatge</button><p>Si no s’ha obert el correu, copia el missatge i envia’l a {site.contactEmail}.</p></div></form></section><EditorialBlocks doc={doc} docs={docs} fullWidth/>
</Layout>
